# Non-secret settings for a dedicated Docloop runner service EnvironmentFile.
# Install a current Docloop wheel from merged source into a new, versioned
# virtual environment before pointing the service at this configuration.
OMNIGENT_FEATURES=docloop_notebook
DOCLOOP_PROVIDER=codex-cli
DOCLOOP_MODEL=gpt-6-luna
DOCLOOP_REASONING_EFFORT=max
DOCLOOP_PYTHON_STATE=1
DOCLOOP_NATIVE_NOTEBOOK=1

# The host allowlist forwards only these named harness settings to runner
# processes. OMNIGENT_FEATURES itself is forwarded by Omnigent's static
# non-secret deployment allowlist.
OMNIGENT_RUNNER_ENV_PASSTHROUGH=DOCLOOP_PROVIDER,DOCLOOP_MODEL,DOCLOOP_REASONING_EFFORT,DOCLOOP_PYTHON_STATE,DOCLOOP_NATIVE_NOTEBOOK
